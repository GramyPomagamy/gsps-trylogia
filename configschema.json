{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "socket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "description": "Address of the companion WebSocket.",
          "default": "localhost"
        },
        "port": {
          "type": "number",
          "description": "Port of the companion WebSocket.",
          "default": 6942
        }
      },
      "required": ["address", "port"]
    },
    "foobar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "address": {
          "type": "string",
          "default": "http://localhost:8880"
        }
      },
      "description": "Info needed to control foobar2000.",
      "required": ["enabled"]
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "username": {
          "type": "string",
          "default": ""
        },
        "password": {
          "type": "string",
          "default": ""
        },
        "eventID": {
          "type": "number",
          "default": 18
        },
        "rootURL": {
          "type": "string",
          "default": "https://gsps.pl/donacje"
        }
      },
      "description": "Login information for the private areas of the tracker API.",
      "required": ["enabled", "rootURL"]
    },
    "players": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "GTA3": {
          "type": "string",
          "default": "9:23:38"
        },
        "GTAVC": {
          "type": "string",
          "default": "22:15:17"
        },
        "GTASA": {
          "type": "string",
          "default": "48:13:46"
        }
      },
      "required": ["GTA3", "GTAVC", "GTASA"]
    }
  },
  "required": ["socket", "foobar", "tracker", "players", "splits"]
}
